<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nordic_gradient_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_remind_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="繳費時程提醒"
        android:textColor="#2C3E50"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_rent_remind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#CCFFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        tools:layout_editor_absoluteX="24dp"
        tools:layout_editor_absoluteY="108dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="定期房租 (每個月固定繳交)"
                android:textColor="#7F8C8D"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_next_rent_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="下次繳費日: 計算中..."
                android:textColor="#2C3E50"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_rent_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="狀態: --"
                android:textColor="#34495E"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_rent_paid"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#2C3E50"
                android:text="已繳本期房租 (+1個月)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_electric_remind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#CCFFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/card_rent_remind">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="台電/流動電費 (每兩個月結算一次)"
                android:textColor="#7F8C8D"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_next_electric_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下次結算日: 計算中..."
                android:textColor="#2C3E50"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tv_electric_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="狀態: --"
                android:textColor="#34495E"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <Button
                android:id="@+id/btn_electric_paid"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#81A1C1"
                android:text="已繳本期電費 (+2個月)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>