<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nordic_gradient_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_evidence_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="入住點交存證相簿"
        android:textColor="#2C3E50"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="HardcodedText"
        tools:layout_editor_absoluteY="45dp" />

    <LinearLayout
        android:id="@+id/layout_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_evidence_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tag_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="全部"
            android:textColor="#2C3E50"
            android:textStyle="bold"
            android:layout_marginEnd="24dp"
            android:textSize="16sp"
            tools:ignore="HardcodedText"/>

        <TextView
            android:id="@+id/tag_bedroom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="臥室"
            android:textColor="#7F8C8D"
            android:layout_marginEnd="24dp"
            android:textSize="16sp"
            tools:ignore="HardcodedText"/>

        <TextView
            android:id="@+id/tag_bathroom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="浴室"
            android:textColor="#7F8C8D"
            android:textSize="16sp"
            tools:ignore="HardcodedText"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_evidence"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/layout_tags"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_empty_gallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="當前分類尚無影像\n點擊下方按鈕捕捉點交鐵證"
        android:gravity="center"
        android:textColor="#7F8C8D"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_take_photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="#FFFFFF"
        android:contentDescription="拍照存證"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="#2C3E50"
        app:fabCustomSize="56dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
